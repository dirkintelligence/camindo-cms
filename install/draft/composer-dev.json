{
    "name": "camindo/project-dev",
    "description": "camindo CMS development project: Core/ is a git checkout, not a composer package (replace)",
    "type": "project",
    "license": "proprietary",
    "replace": {
        "camindo/cms": "9.x-dev"
    },
    "require": {
        "php": ">=8.3",
        "camindo/composer-plugin": "^1.0",
        "phpmailer/phpmailer": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Camindo\\": "",
            "Camindo\\Core\\": "Core/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "camindo/composer-plugin": true,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "@php Core/cron/camindo.php status --after-composer",
        "post-update-cmd": "@php Core/cron/camindo.php status --after-composer"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../camindo-composer-plugin",
            "options": {
                "versions": {
                    "camindo/composer-plugin": "1.0.0"
                }
            }
        }
    ]
}

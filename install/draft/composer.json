{
    "name": "camindo/project",
    "description": "camindo CMS project skeleton: composer create-project camindo/project mysite",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "camindo/composer-plugin": "^1.0",
        "camindo/cms": "^9.0"
    },
    "autoload": {
        "psr-4": { "Camindo\\": "" }
    },
    "config": {
        "allow-plugins": {
            "camindo/composer-plugin": true,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": "@php Core/cron/camindo.php install",
        "post-install-cmd": "@php Core/cron/camindo.php status --after-composer",
        "post-update-cmd": "@php Core/cron/camindo.php status --after-composer"
    }
}
